    "GITHUB_CLIENT_ID": "Iv23lixjTGgPaq9Jfp6R"
  },
  "secrets": {
    "required": [
      "GITHUB_CLIENT_SECRET",
      "SESSION_KEY"
    ]
  },
  "observability": {
