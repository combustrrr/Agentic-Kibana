{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "code-analysis-launcher",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "vars": {
    "SOURCE_REPOSITORY": "ARYDESTROYER/Kavach-AgenticSOC",
