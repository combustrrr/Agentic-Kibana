# ============================================================
# Canary Test Suite: Insecure Dockerfile
#
# This file DELIBERATELY contains security misconfigurations.
# It exists to validate that the scanner pipeline detects them.
#
# Expected detections: Hadolint (DL3002), Checkov (CKV_DOCKER_2)
# ============================================================

# VULNERABLE: Running as root (no USER directive)
# VULNERABLE: Not pinning base image tag (no :digest)
FROM ubuntu:latest

# VULNERABLE: apt-get without --no-install-recommends
# VULNERABLE: apt-get without rm -rf /var/lib/apt/lists/*
RUN apt-get update && \
    apt-get install -y python3 python3-pip curl && \
    apt-get clean

# VULNERABLE: Copying files without verifying checksum
COPY . /app

# VULNERABLE: Running as root (no USER directive)
WORKDIR /app
RUN pip3 install -r requirements.txt --no-cache-dir

# VULNERABLE: Exposing debug port
EXPOSE 8080

# VULNERABLE: Running the app as root
CMD ["python3", "app.py"]
